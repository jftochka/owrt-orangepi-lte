config global 'global'
	option at_host '127.0.0.1'
	option at_port '5000'
	option tty '/dev/ttyUSB2'
	option qmi_dev '/dev/cdc-wdm0'
	option wwan_iface 'wwan'
	option wwan_dev 'wwan0'
	option auto_apply '0'
	option esim_backend 'at'
	option esim_tty '/dev/ttyUSB3'
	# esim_backend: at | uqmi | auto (auto tries uqmi first and falls back to at)
	# esim_debug 1 makes lpac and the uqmi driver log their traffic; esim_retries is the
	# number of extra attempts after an euicc_init / no-answer failure (SFT-142)
	option esim_debug '0'
	option esim_retries '1'

