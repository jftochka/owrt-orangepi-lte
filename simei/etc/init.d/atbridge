#!/bin/sh /etc/rc.common
# atbridge - expose the modem AT port on TCP with socat, one client at a time.
# Port and tty come from /etc/config/simei (global.at_port, global.tty).

USE_PROCD=1
START=90
STOP=10

start_service() {
	local port tty
	config_load simei
	config_get port global at_port 5000
	config_get tty global tty /dev/ttyUSB2

	procd_open_instance atbridge
	procd_set_param command /usr/bin/socat "TCP-LISTEN:$port,reuseaddr,fork,max-children=1" "$tty,raw,echo=0,b115200"
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger simei
}
