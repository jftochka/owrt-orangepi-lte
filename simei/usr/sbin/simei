#!/bin/sh
# simei - SIM / IMEI manager for OpenWrt with a Quectel modem (EG25-G).
#
# Keeps one profile per SIM card (ICCID -> name, IMEI, APN) and writes the profile's IMEI
# into the modem with AT+EGMR=1,7 when that SIM is inserted. TUI (whiptail, or plain text
# on a dumb console) plus a CLI with the same actions. POSIX sh, BusyBox ash compatible.
#
# AT traffic goes through the atbridge service (socat TCP <-> /dev/ttyUSB2) so the modem
# can be shared with other tools and reached from other hosts.
#
# Environment overrides (mainly for tests): SIMEI_UCI_DIR SIMEI_AT_HOST SIMEI_AT_PORT
# SIMEI_QMI_DEV SIMEI_WWAN_IFACE SIMEI_WWAN_DEV SIMEI_SYSFS SIMEI_FACTORY_FILE
# SIMEI_AT_TIMEOUT SIMEI_APPLY_TIMEOUT SIMEI_UI (whiptail|text) SIMEI_NO_ANSI
# SIMEI_LIVE_INTERVAL SIMEI_LIVE_PREV ("rx tx" bytes, replaces the first sample)

VERSION=0.1.0
trap '' PIPE

# ---- configuration -----------------------------------------------------------
UCI_DIR=${SIMEI_UCI_DIR:-}
uci_cmd() {
	if [ -n "$UCI_DIR" ]; then uci -c "$UCI_DIR" "$@"; else uci "$@"; fi
}
cfg() { uci_cmd -q get "simei.$1" 2>/dev/null; }

AT_HOST=${SIMEI_AT_HOST:-$(cfg global.at_host)};       AT_HOST=${AT_HOST:-127.0.0.1}
AT_PORT=${SIMEI_AT_PORT:-$(cfg global.at_port)};       AT_PORT=${AT_PORT:-5000}
QMI_DEV=${SIMEI_QMI_DEV:-$(cfg global.qmi_dev)};       QMI_DEV=${QMI_DEV:-/dev/cdc-wdm0}
WWAN_IFACE=${SIMEI_WWAN_IFACE:-$(cfg global.wwan_iface)}; WWAN_IFACE=${WWAN_IFACE:-wwan}
WWAN_DEV=${SIMEI_WWAN_DEV:-$(cfg global.wwan_dev)};    WWAN_DEV=${WWAN_DEV:-wwan0}
SYSFS=${SIMEI_SYSFS:-/sys/class/net/$WWAN_DEV/statistics}
FACTORY_FILE=${SIMEI_FACTORY_FILE:-/etc/simei.factory-imei}
AT_TIMEOUT=${SIMEI_AT_TIMEOUT:-5}
AT_IDLE=30
APPLY_TIMEOUT=${SIMEI_APPLY_TIMEOUT:-90}
NO_ANSI=${SIMEI_NO_ANSI:-0}
ESIM_BACKEND=${SIMEI_ESIM_BACKEND:-$(cfg global.esim_backend)}; ESIM_BACKEND=${ESIM_BACKEND:-at}
ESIM_TTY=${SIMEI_ESIM_TTY:-$(cfg global.esim_tty)};             ESIM_TTY=${ESIM_TTY:-/dev/ttyUSB3}
LPAC=${SIMEI_LPAC:-}
ESIM_PREPPED=0
AT_PID=; AT_TMP=

# ---- helpers -----------------------------------------------------------------
die() { printf 'simei: %s\n' "$1" >&2; exit "${2:-1}"; }
log() { logger -t simei "$*" 2>/dev/null; }
have() { command -v "$1" >/dev/null 2>&1; }

# 100 ms tick where sleep supports fractions, 1 s otherwise
if sleep 0.1 2>/dev/null; then TICK=0.1; TICKS=10; msleep() { sleep 0.1; }
elif command -v usleep >/dev/null 2>&1; then TICK=0.1; TICKS=10; msleep() { usleep 100000; }
else TICK=1; TICKS=1; msleep() { sleep 1; }; fi
# read -t (integer seconds) is available on BusyBox ash and bash, not on dash
if ( read -t 1 _x < /dev/null ) 2>/dev/null; then READ_T=1; else READ_T=0; fi

luhn_digit() {  # 14 digits -> check digit
	awk -v n="$1" 'BEGIN {
		s = 0
		for (i = 1; i <= 14; i++) { d = substr(n, i, 1) + 0; if (i % 2 == 0) { d *= 2; if (d > 9) d -= 9 } s += d }
		print (10 - s % 10) % 10
	}'
}
is_digits() { case $1 in ''|*[!0-9]*) return 1 ;; esac; return 0; }
imei_valid() {  # 15 digits with a correct Luhn check digit, and not the blank all-zero value
	is_digits "$1" || return 1
	[ ${#1} -eq 15 ] || return 1
	[ "$1" != 000000000000000 ] || return 1
	[ "$(luhn_digit "${1%?}")" = "${1#??????????????}" ]
}

# ---- AT transport (one TCP session to the bridge, several commands) -----------
at_open() {
	have socat || die "socat is not installed" 5
	AT_TMP=$(mktemp -d "${TMPDIR:-/tmp}/simei.XXXXXX") || return 1
	mkfifo "$AT_TMP/in" || return 1
	: > "$AT_TMP/out"
	socat -T "$AT_IDLE" - "TCP:$AT_HOST:$AT_PORT,connect-timeout=3" < "$AT_TMP/in" > "$AT_TMP/out" 2> "$AT_TMP/err" &
	AT_PID=$!
	exec 3> "$AT_TMP/in"
	msleep
	if ! kill -0 "$AT_PID" 2>/dev/null; then at_close; return 1; fi
	return 0
}

at_close() {
	exec 3>&-
	if [ -n "$AT_PID" ]; then
		local i=0
		while kill -0 "$AT_PID" 2>/dev/null && [ $i -lt "$TICKS" ]; do msleep; i=$((i + 1)); done
		kill "$AT_PID" 2>/dev/null
		wait "$AT_PID" 2>/dev/null
	fi
	[ -n "$AT_TMP" ] && rm -rf "$AT_TMP"
	AT_PID=; AT_TMP=
}

# at_cmd "<command>" [timeout] -> prints the response lines (no echo, no blanks, CRs stripped)
at_cmd() {
	local cmd=$1 to=${2:-$AT_TIMEOUT} start i=0
	start=$(wc -l < "$AT_TMP/out"); start=$((start + 0))
	printf '%s\r' "$cmd" >&3 2>/dev/null || return 1
	while :; do
		if tail -n +$((start + 1)) "$AT_TMP/out" | tr -d '\r' \
			| grep -qE '^(OK|ERROR|\+CME ERROR|\+CMS ERROR|COMMAND NOT SUPPORT|NO CARRIER)'; then break; fi
		kill -0 "$AT_PID" 2>/dev/null || break
		[ $i -ge $((to * TICKS)) ] && break
		msleep; i=$((i + 1))
	done
	tail -n +$((start + 1)) "$AT_TMP/out" | tr -d '\r' | sed '/^[[:space:]]*$/d' | grep -vxF -- "$cmd"
	return 0
}

at_once() {  # single command in its own session
	at_open || die "cannot reach the AT bridge at $AT_HOST:$AT_PORT (is atbridge running?)" 5
	at_cmd "$@"
	at_close
}

# ---- modem information ---------------------------------------------------------
cme_text() {
	case $1 in
		10) echo "SIM not inserted" ;; 11) echo "SIM PIN required" ;; 12) echo "SIM PUK required" ;;
		13) echo "SIM failure" ;; 14) echo "SIM busy" ;; *) echo "CME error $1" ;;
	esac
}
act_text() {
	case ${1:-} in
		0) echo GSM ;; 1) echo "GSM Compact" ;; 2) echo UMTS ;; 3) echo EDGE ;; 4) echo HSDPA ;; 5) echo HSUPA ;;
		6) echo HSPA ;; 7) echo LTE ;; 8) echo "LTE-M" ;; 9) echo "NB-IoT" ;; 10) echo "LTE Cat-M" ;; '') echo "-" ;;
		*) echo "act $1" ;;
	esac
}
reg_text() {
	case ${1:-} in
		0) echo "not registered" ;; 1) echo "registered, home" ;; 2) echo "searching" ;; 3) echo "denied" ;;
		4) echo "unknown" ;; 5) echo "registered, roaming" ;; '') echo "-" ;; *) echo "state $1" ;;
	esac
}

# Fills M_IMEI M_ICCID M_IMSI M_CPIN M_CSQ M_RSSI M_OPER M_ACT M_REG. Returns 1 if the modem did not answer.
modem_read() {
	local c
	M_IMEI=; M_ICCID=; M_IMSI=; M_CPIN=; M_CSQ=; M_RSSI=; M_OPER=; M_ACT=; M_REG=
	at_open || return 1
	M_IMEI=$(at_cmd AT+GSN | grep -E '^[0-9]{15}$' | head -n1)
	M_ICCID=$(at_cmd AT+QCCID | sed -n 's/^+QCCID: *//p' | head -n1 | tr -d ' ' | sed 's/[Ff]$//')
	M_IMSI=$(at_cmd AT+CIMI | grep -E '^[0-9]{6,15}$' | head -n1)
	c=$(at_cmd 'AT+CPIN?' | sed -n -e 's/^+CPIN: *//p' -e 's/^+CME ERROR: *\([0-9]*\).*/CME \1/p' | head -n1)
	case $c in "CME "*) M_CPIN=$(cme_text "${c#CME }") ;; *) M_CPIN=$c ;; esac
	M_CSQ=$(at_cmd AT+CSQ | sed -n 's/^+CSQ: *\([0-9]*\),.*/\1/p' | head -n1)
	c=$(at_cmd 'AT+COPS?' | sed -n 's/^+COPS: *//p' | head -n1)
	M_OPER=$(printf '%s' "$c" | sed -n 's/^[^"]*"\([^"]*\)".*/\1/p')
	M_ACT=$(printf '%s' "$c" | sed -n 's/.*",\([0-9]*\) *$/\1/p')
	M_REG=$(at_cmd 'AT+CEREG?' | sed -n 's/^+CEREG: *[0-9]*,\([0-9]*\).*/\1/p' | head -n1)
	at_close
	if [ -n "$M_CSQ" ] && [ "$M_CSQ" != 99 ]; then M_RSSI=$((-113 + 2 * M_CSQ)); fi
	[ -n "$M_IMEI" ]
}

# ---- profiles (UCI: config profile 'simN' / option name iccid imei apn) --------
profile_ids() { uci_cmd -q show simei 2>/dev/null | sed -n 's/^simei\.\([^.=]*\)=profile$/\1/p'; }
profile_get() { cfg "$1.$2"; }
profile_exists() { [ "$(cfg "$1")" = profile ]; }
profile_by_iccid() {
	local p
	[ -n "$1" ] || return 1
	for p in $(profile_ids); do
		if [ "$(profile_get "$p" iccid)" = "$1" ]; then echo "$p"; return 0; fi
	done
	return 1
}
profile_next_id() { local n=1; while profile_exists "sim$n"; do n=$((n + 1)); done; echo "sim$n"; }
profile_create() { uci_cmd set "simei.$1=profile" >/dev/null; }
profile_set() { uci_cmd set "simei.$1.$2=$3" >/dev/null; }
profile_clear() { uci_cmd -q delete "simei.$1.$2" >/dev/null 2>&1; }
profile_commit() { uci_cmd commit simei; }
profile_line() {  # id -> "id | name | iccid | imei | apn"
	printf '%-6s %-20s %-22s %-16s %s\n' "$1" "$(profile_get "$1" name)" "$(profile_get "$1" iccid)" \
		"$(profile_get "$1" imei)" "$(profile_get "$1" apn)"
}
require_profile() { profile_exists "$1" || die "no such profile: $1 (see: simei list)" 1; }

# Match the inserted SIM (M_ICCID) to a profile. Sets P_ID P_NAME P_IMEI P_MATCH (yes|no|none).
match_profile() {
	P_ID=$(profile_by_iccid "$M_ICCID") || P_ID=
	P_NAME=; P_IMEI=; P_MATCH=none
	if [ -n "$P_ID" ]; then
		P_NAME=$(profile_get "$P_ID" name); P_IMEI=$(profile_get "$P_ID" imei)
		if [ -n "$P_IMEI" ] && [ "$P_IMEI" = "$M_IMEI" ]; then P_MATCH=yes; else P_MATCH=no; fi
	fi
}

# ---- UI primitives (whiptail or plain text) --------------------------------------
if [ -n "${SIMEI_UI:-}" ]; then UI_MODE=$SIMEI_UI
elif have whiptail && [ -t 0 ] && [ -t 1 ]; then UI_MODE=whiptail
else UI_MODE=text; fi

# ui_menu TITLE TEXT tag desc [tag desc ...] -> prints the chosen tag, returns 1 on cancel
ui_menu() {
	local t=$1 x=$2 tags= i=1 c tag
	shift 2
	if [ "$UI_MODE" = whiptail ]; then
		whiptail --title "$t" --menu "$x" 24 78 14 "$@" 3>&1 1>&2 2>&3
		return
	fi
	printf '\n== %s ==\n%s\n' "$t" "$x" >&2
	while [ $# -ge 2 ]; do
		printf '  %2d) %-10s %s\n' "$i" "$1" "$2" >&2
		tags="$tags $1"; i=$((i + 1)); shift 2
	done
	printf 'Choice (number or name, empty = back): ' >&2
	read -r c || return 1
	[ -n "$c" ] || return 1
	i=1
	for tag in $tags; do
		if [ "$c" = "$i" ] || [ "$c" = "$tag" ]; then echo "$tag"; return 0; fi
		i=$((i + 1))
	done
	return 1
}
ui_input() {  # TITLE TEXT DEFAULT -> value
	local v
	if [ "$UI_MODE" = whiptail ]; then
		whiptail --title "$1" --inputbox "$2" 10 70 "$3" 3>&1 1>&2 2>&3
		return
	fi
	printf '%s [%s]: ' "$2" "$3" >&2
	read -r v || return 1
	printf '%s\n' "${v:-$3}"
}
ui_yesno() {  # TITLE TEXT -> 0 yes / 1 no
	local v
	if [ "$UI_MODE" = whiptail ]; then whiptail --title "$1" --yesno "$2" 14 70; return; fi
	printf '%s\n%s [y/N]: ' "$1" "$2" >&2
	read -r v || return 1
	case $v in y|Y|yes|YES) return 0 ;; *) return 1 ;; esac
}
ui_msg() {  # TITLE TEXT
	if [ "$UI_MODE" = whiptail ]; then whiptail --title "$1" --scrolltext --msgbox "$2" 22 78; return; fi
	printf '\n== %s ==\n%s\n' "$1" "$2"
	if [ -t 0 ]; then printf '[Enter to continue] ' >&2; read -r _ || true; fi
}

# ---- formatting -----------------------------------------------------------------
status_lines() {  # after modem_read + match_profile; pretty text
	local sig="-" ptxt="none (run: register)"
	[ -n "$M_RSSI" ] && sig="$M_RSSI dBm (CSQ $M_CSQ)"
	if [ -n "$P_ID" ]; then
		ptxt="$P_ID \"$P_NAME\"  IMEI ${P_IMEI:--}"
		case $P_MATCH in yes) ptxt="$ptxt  [modem IMEI matches]" ;; no) ptxt="$ptxt  [DIFFERS from modem - run apply]" ;; esac
	fi
	printf 'IMEI        : %s%s\n' "${M_IMEI:--}" "$( [ -n "$M_IMEI" ] && ! imei_valid "$M_IMEI" && printf '  (blank/invalid IMEI)' )"
	printf 'SIM ICCID   : %s\n' "${M_ICCID:--}"
	printf 'IMSI        : %s\n' "${M_IMSI:--}"
	printf 'SIM status  : %s\n' "${M_CPIN:--}"
	printf 'Signal      : %s\n' "$sig"
	printf 'Operator    : %s (%s)\n' "${M_OPER:--}" "$(act_text "$M_ACT")"
	printf 'Registration: %s\n' "$(reg_text "$M_REG")"
	printf 'Profile     : %s\n' "$ptxt"
	printf 'AT bridge   : %s:%s\n' "$AT_HOST" "$AT_PORT"
}
status_raw() {
	printf 'imei=%s\niccid=%s\nimsi=%s\ncpin=%s\ncsq=%s\nrssi_dbm=%s\noperator=%s\nact=%s\nreg=%s\n' \
		"$M_IMEI" "$M_ICCID" "$M_IMSI" "$M_CPIN" "$M_CSQ" "$M_RSSI" "$M_OPER" "$(act_text "$M_ACT")" "$(reg_text "$M_REG")"
	printf 'profile=%s\nprofile_name=%s\nprofile_imei=%s\nimei_match=%s\n' "$P_ID" "$P_NAME" "$P_IMEI" "$P_MATCH"
}
fmt_rate() {  # bits per second -> human
	awk -v b="$1" 'BEGIN { if (b >= 1000000) printf "%.1f Mbit/s", b / 1000000; else printf "%.0f kbit/s", b / 1000 }'
}
fmt_bytes() {
	awk -v b="$1" 'BEGIN { if (b >= 1073741824) printf "%.2f GiB", b / 1073741824; else if (b >= 1048576) printf "%.1f MiB", b / 1048576; else printf "%.0f KiB", b / 1024 }'
}
json_num() { printf '%s' "$1" | sed -n "s/.*\"$2\":\([-0-9.]*\).*/\1/p" | head -n1; }
json_str() { printf '%s' "$1" | sed -n "s/.*\"$2\":\"\([^\"]*\)\".*/\1/p" | head -n1; }
sig_bar() {  # rsrp dBm -> 20-char bar (-140 .. -80)
	awk -v r="$1" 'BEGIN { n = int((r + 140) / 3); if (n < 0) n = 0; if (n > 20) n = 20; s = ""
		for (i = 0; i < 20; i++) s = s (i < n ? "#" : "."); print s }'
}

# ---- commands -----------------------------------------------------------------
cmd_status() {
	modem_read || die "modem did not answer via $AT_HOST:$AT_PORT" 5
	match_profile
	if [ "${1:-}" = --raw ]; then status_raw; else status_lines; fi
}

cmd_list() {
	local p n=0
	printf '%-6s %-20s %-22s %-16s %s\n' ID NAME ICCID IMEI APN
	for p in $(profile_ids); do profile_line "$p"; n=$((n + 1)); done
	[ $n -eq 0 ] && echo "(no profiles - use: simei register, simei add)" >&2
	return 0
}

cmd_register() {  # [name] [--update]
	local name= update=0 id a
	for a in "$@"; do case $a in --update) update=1 ;; *) name=$a ;; esac; done
	modem_read || die "modem did not answer" 5
	[ -n "$M_ICCID" ] || die "no SIM detected (${M_CPIN:-no answer})" 3
	if id=$(profile_by_iccid "$M_ICCID"); then
		[ $update -eq 1 ] || die "SIM $M_ICCID is already registered as $id ($(profile_get "$id" name)); use --update to refresh its IMEI" 1
	else
		id=$(profile_next_id)
		profile_create "$id"
		profile_set "$id" name "${name:-SIM ${id#sim}}"
		profile_set "$id" iccid "$M_ICCID"
	fi
	[ -n "$name" ] && profile_set "$id" name "$name"
	if imei_valid "$M_IMEI"; then profile_set "$id" imei "$M_IMEI"
	else echo "note: modem IMEI $M_IMEI is blank/invalid, not stored; assign one with: simei set $id imei <imei>" >&2; fi
	[ -n "$M_IMSI" ] && profile_set "$id" imsi "$M_IMSI"
	profile_commit
	log "registered $id iccid=$M_ICCID imei=$M_IMEI"
	echo "registered $id: $(profile_get "$id" name)  ICCID $M_ICCID  IMEI $(profile_get "$id" imei | sed 's/^$/-/')"
}

cmd_add() {  # name iccid [imei] [apn]
	local name=${1:-} iccid=${2:-} imei=${3:-} apn=${4:-} id
	[ -n "$name" ] && [ -n "$iccid" ] || die "usage: simei add <name> <iccid> [imei] [apn]" 64
	is_digits "$iccid" || die "ICCID must be digits" 1
	profile_by_iccid "$iccid" >/dev/null && die "ICCID $iccid already registered" 1
	if [ -n "$imei" ]; then imei_valid "$imei" || die "IMEI $imei is not a valid 15-digit IMEI" 2; fi
	id=$(profile_next_id)
	profile_create "$id"
	profile_set "$id" name "$name"
	profile_set "$id" iccid "$iccid"
	[ -n "$imei" ] && profile_set "$id" imei "$imei"
	[ -n "$apn" ] && profile_set "$id" apn "$apn"
	profile_commit
	echo "added $id: $name  ICCID $iccid  IMEI ${imei:--}"
}

cmd_set() {  # id field value
	local id=${1:-} f=${2:-} v=${3:-}
	[ -n "$id" ] && [ -n "$f" ] || die "usage: simei set <profile> name|imei|apn|iccid <value>" 64
	require_profile "$id"
	case $f in
		imei)
			if [ -n "$v" ]; then
				if is_digits "$v" && [ ${#v} -eq 14 ]; then v="$v$(luhn_digit "$v")"; echo "check digit added: $v"; fi
				imei_valid "$v" || die "$v is not a valid IMEI (15 digits, Luhn check)" 2
			fi ;;
		iccid) is_digits "$v" || die "ICCID must be digits" 1 ;;
		name|apn) ;;
		*) die "unknown field $f (name|imei|apn|iccid)" 64 ;;
	esac
	if [ -n "$v" ]; then profile_set "$id" "$f" "$v"; else profile_clear "$id" "$f"; fi
	profile_commit
	echo "$id.$f = ${v:-(cleared)}"
}

cmd_delete() {
	local id=${1:-}
	[ -n "$id" ] || die "usage: simei delete <profile>" 64
	require_profile "$id"
	uci_cmd delete "simei.$id" && profile_commit
	echo "deleted $id"
}

cmd_move() {  # from to  (target takes the IMEI, source loses it)
	local from=${1:-} to=${2:-} imei
	[ -n "$from" ] && [ -n "$to" ] || die "usage: simei move <from> <to>" 64
	require_profile "$from"; require_profile "$to"
	[ "$from" != "$to" ] || die "source and target are the same profile" 1
	imei=$(profile_get "$from" imei)
	[ -n "$imei" ] || die "profile $from has no IMEI to move" 1
	profile_set "$to" imei "$imei"
	profile_clear "$from" imei
	profile_commit
	log "moved IMEI $imei from $from to $to"
	echo "IMEI $imei moved: $from -> $to"
}

cmd_swap() {
	local a=${1:-} b=${2:-} ia ib
	[ -n "$a" ] && [ -n "$b" ] || die "usage: simei swap <profile> <profile>" 64
	require_profile "$a"; require_profile "$b"
	ia=$(profile_get "$a" imei); ib=$(profile_get "$b" imei)
	if [ -n "$ib" ]; then profile_set "$a" imei "$ib"; else profile_clear "$a" imei; fi
	if [ -n "$ia" ]; then profile_set "$b" imei "$ia"; else profile_clear "$b" imei; fi
	profile_commit
	log "swapped IMEI $a<->$b"
	echo "swapped: $a now ${ib:--}, $b now ${ia:--}"
}

ifup_wwan() { have ifup && ifup "$WWAN_IFACE" >/dev/null 2>&1; return 0; }

# write IMEI to the modem, restart it, verify.  Exit: 0 ok, 2 bad IMEI, 3 no SIM/profile, 4 modem refused, 5 no modem
cmd_apply() {
	local yes=0 dry=0 a p want cur r waited=0
	for a in "$@"; do case $a in --yes|-y) yes=1 ;; --dry-run|-n) dry=1 ;; esac; done
	modem_read || die "modem did not answer via $AT_HOST:$AT_PORT" 5
	[ -n "$M_ICCID" ] || die "no SIM detected (${M_CPIN:-no answer})" 3
	p=$(profile_by_iccid "$M_ICCID") || die "no profile for the inserted SIM (ICCID $M_ICCID); run: simei register" 3
	want=$(profile_get "$p" imei)
	[ -n "$want" ] || die "profile $p ($(profile_get "$p" name)) has no IMEI assigned" 3
	imei_valid "$want" || die "profile $p IMEI $want fails the IMEI check (15 digits, Luhn)" 2
	if [ "$want" = "$M_IMEI" ]; then
		echo "nothing to do: modem IMEI is already $want (profile $p, $(profile_get "$p" name))"
		return 0
	fi
	echo "SIM $M_ICCID -> profile $p ($(profile_get "$p" name))"
	echo "IMEI change: $M_IMEI -> $want"
	[ $dry -eq 1 ] && return 0
	if [ $yes -ne 1 ]; then
		[ -t 0 ] || die "refusing to write without confirmation; add --yes" 1
		ui_yesno "Write IMEI to modem" "Profile: $p ($(profile_get "$p" name))
SIM ICCID: $M_ICCID

Modem IMEI now: $M_IMEI
Write IMEI:     $want

The modem restarts afterwards (about 20 s). Continue?" || die "cancelled" 1
	fi
	# remember the original IMEI once (but never an all-zero / invalid one)
	if [ ! -f "$FACTORY_FILE" ] && imei_valid "$M_IMEI"; then printf '%s\n' "$M_IMEI" > "$FACTORY_FILE" 2>/dev/null; fi
	at_open || die "lost the AT bridge" 5
	r=$(at_cmd "AT+EGMR=1,7,\"$want\"" 10)
	if ! printf '%s\n' "$r" | grep -qx OK; then at_close; die "modem refused the IMEI write: ${r:-no answer}" 4; fi
	r=$(at_cmd 'AT+CFUN=1,1' 10)
	at_close
	log "IMEI $M_IMEI -> $want for SIM $M_ICCID (profile $p)"
	echo "written; restarting the modem and waiting for it to come back..."
	while :; do
		if at_open 2>/dev/null; then
			cur=$(at_cmd AT+GSN 3 | grep -E '^[0-9]{15}$' | head -n1)
			at_close
			if [ "$cur" = "$want" ]; then
				echo "verified: modem IMEI is now $cur"
				ifup_wwan
				return 0
			fi
		fi
		[ $waited -ge "$APPLY_TIMEOUT" ] && break
		sleep 3; waited=$((waited + 3))
	done
	die "timed out waiting for the modem to report IMEI $want; check with: simei status" 4
}

cmd_at() {
	[ $# -ge 1 ] || die "usage: simei at \"AT+...\"" 64
	at_once "$*" 10
}

cmd_luhn() {
	local n=${1:-}
	is_digits "$n" || die "usage: simei luhn <14 or 15 digits>" 64
	case ${#n} in
		14) echo "$n$(luhn_digit "$n")" ;;
		15) if imei_valid "$n"; then echo "valid"; else echo "invalid (expected check digit $(luhn_digit "${n%?}"))"; return 1; fi ;;
		*) die "need 14 digits (to compute the check digit) or 15 (to verify)" 1 ;;
	esac
}

cmd_restart() {
	case ${1:-} in
		modem) at_once 'AT+CFUN=1,1' 10 | grep -qx OK && echo "modem restarting" || die "modem did not accept AT+CFUN=1,1" 4 ;;
		wwan) have ifdown && ifdown "$WWAN_IFACE"; ifup_wwan; echo "wwan restarted" ;;
		bridge) [ -x /etc/init.d/atbridge ] && /etc/init.d/atbridge restart; echo "atbridge restarted" ;;
		*) die "usage: simei restart modem|wwan|bridge" 64 ;;
	esac
}

# ---- live dashboard --------------------------------------------------------------
live_frame() {  # rx_bps tx_bps rx_total tx_total signal_json
	local sig=$5 type rssi rsrp rsrq snr
	[ "$NO_ANSI" = 1 ] || printf '\033[H\033[2J'
	printf 'simei live   %s   %s   (${LIVE_HINT:-Ctrl-C: back})\n\n' "$(date '+%H:%M:%S')" "$WWAN_DEV"
	printf '  Down  %-16s  Up  %-16s\n' "$(fmt_rate "$1")" "$(fmt_rate "$2")"
	printf '  Total %-16s      %-16s\n' "$(fmt_bytes "$3")" "$(fmt_bytes "$4")"
	if [ -n "$sig" ]; then
		type=$(json_str "$sig" type); rssi=$(json_num "$sig" rssi); rsrp=$(json_num "$sig" rsrp)
		rsrq=$(json_num "$sig" rsrq); snr=$(json_num "$sig" snr)
		printf '\n  %s  RSSI %s dBm  RSRP %s dBm  RSRQ %s dB  SNR %s dB\n' "$(printf '%s' "$type" | tr 'a-z' 'A-Z')" "${rssi:--}" "${rsrp:--}" "${rsrq:--}" "${snr:--}"
		[ -n "$rsrp" ] && printf '  [%s]\n' "$(sig_bar "$rsrp")"
	else
		printf '\n  signal: n/a (uqmi/%s)\n' "$QMI_DEV"
	fi
	printf '\n  IMEI %s   ICCID %s\n  %s (%s)  %s\n' "${M_IMEI:--}" "${M_ICCID:--}" "${M_OPER:--}" "$(act_text "$M_ACT")" "$(reg_text "$M_REG")"
	[ -n "$P_ID" ] && printf '  profile %s "%s"  IMEI %s [%s]\n' "$P_ID" "$P_NAME" "${P_IMEI:--}" "$P_MATCH"
	return 0
}

live_wait() {  # one interval; returns 0 when the user asked to leave
	local key
	if [ -n "$saved" ]; then key=$(dd bs=1 count=1 2>/dev/null); [ -n "$key" ]
	elif [ "$READ_T" = 1 ] && [ -t 0 ]; then read -t "$interval" -r key
	else sleep "$interval"; return 1; fi
}

cmd_live() {
	local once=0 interval=${SIMEI_LIVE_INTERVAL:-1} prx ptx srx stx rx tx rxr txr tick=0 sig= key saved= ip=
	[ "${1:-}" = --once ] && once=1
	[ -r "$SYSFS/rx_bytes" ] || die "no counters at $SYSFS (is $WWAN_DEV up?)" 1
	modem_read 2>/dev/null && match_profile
	rx=$(cat "$SYSFS/rx_bytes"); tx=$(cat "$SYSFS/tx_bytes")
	if [ -n "${SIMEI_LIVE_PREV:-}" ]; then prx=${SIMEI_LIVE_PREV% *}; ptx=${SIMEI_LIVE_PREV#* }; else prx=$rx; ptx=$tx; fi
	srx=$prx; stx=$ptx
	LIVE_HINT="Ctrl-C: back"; [ "$READ_T" = 1 ] && [ -t 0 ] && LIVE_HINT="Enter: back"
	if [ $once -eq 0 ] && [ -t 0 ]; then
		saved=$(stty -g 2>/dev/null) && stty -icanon -echo min 0 time $((interval * 10)) 2>/dev/null || saved=
	fi
	[ -n "$saved" ] && LIVE_HINT="any key: back"
	while :; do
		if [ $once -eq 0 ] || [ -z "${SIMEI_LIVE_PREV:-}" ]; then
			live_wait && break
		fi
		rx=$(cat "$SYSFS/rx_bytes"); tx=$(cat "$SYSFS/tx_bytes")
		rxr=$(( (rx - prx) * 8 / interval )); txr=$(( (tx - ptx) * 8 / interval ))
		[ $rxr -lt 0 ] && rxr=0; [ $txr -lt 0 ] && txr=0
		prx=$rx; ptx=$tx
		if [ $((tick % 3)) -eq 0 ] && have uqmi; then sig=$(uqmi -d "$QMI_DEV" --get-signal-info 2>/dev/null | tr -d '\n '); fi
		live_frame "$rxr" "$txr" "$((rx - srx))" "$((tx - stx))" "$sig"
		tick=$((tick + 1))
		[ $once -eq 1 ] && break
	done
	[ -n "$saved" ] && stty "$saved" 2>/dev/null
	return 0
}

# ---- eSIM (eUICC) via lpac -----------------------------------------------------------
iccid_norm() { printf '%s' "$1" | tr -d ' ' | sed 's/[Ff]$//'; }   # AT+QCCID appends a filler F

run_with_timeout() {  # SECS cmd... (stdout passes through; the watchdog is silent)
	local secs=$1 pid wd rc; shift
	if have timeout; then timeout "$secs" "$@"; return; fi
	"$@" & pid=$!
	( sleep "$secs"; kill "$pid" 2>/dev/null ) >/dev/null 2>&1 & wd=$!
	wait "$pid"; rc=$?
	kill "$wd" 2>/dev/null; wait "$wd" 2>/dev/null
	return $rc
}

lpac_bin() {
	if [ -n "$LPAC" ]; then echo "$LPAC"
	elif [ -x /usr/lib/lpac ]; then echo /usr/lib/lpac      # the real binary behind OpenWrt's wrapper
	else command -v lpac; fi
}

esim_prep() {  # quiet AT port for lpac's AT backend: raw, echo off
	[ "$ESIM_PREPPED" = 1 ] && return 0
	ESIM_PREPPED=1
	[ -c "$ESIM_TTY" ] || return 0
	have stty && stty -F "$ESIM_TTY" 115200 raw -echo >/dev/null 2>&1
	printf 'ATE0\r' > "$ESIM_TTY" 2>/dev/null
	sleep 1
}

lpac_run() {  # lpac args -> JSON on stdout
	local bin secs=${LPAC_TIMEOUT:-60}
	bin=$(lpac_bin) || true
	[ -n "$bin" ] || die "lpac is not installed (apk add lpac jq)" 5
	have jq || die "jq is not installed (apk add jq)" 5
	case $1 in profile) [ "$2" = download ] && secs=300 ;; esac
	if [ "$ESIM_BACKEND" = at ]; then
		esim_prep
		LPAC_APDU=at LPAC_APDU_AT_DEVICE="$ESIM_TTY" LPAC_HTTP=curl run_with_timeout "$secs" "$bin" "$@" 2>/dev/null
	else
		LPAC_APDU="$ESIM_BACKEND" LPAC_APDU_QMI_DEVICE="$QMI_DEV" LPAC_HTTP=curl run_with_timeout "$secs" "$bin" "$@" 2>/dev/null
	fi
}

lpac_check() {  # JSON -> 0 when payload.code == 0, else message on stderr and 1
	local code msg
	code=$(printf '%s' "$1" | jq -r '.payload.code // -1' 2>/dev/null)
	[ "$code" = 0 ] && return 0
	msg=$(printf '%s' "$1" | jq -r '.payload.message // "no answer"' 2>/dev/null)
	printf 'lpac: %s (code %s)\n' "${msg:-no answer from lpac}" "${code:--}" >&2
	return 1
}

esim_rows() {  # iccid|state|name|nick|provider per line
	local j
	j=$(lpac_run profile list) || true
	lpac_check "$j" || return 1
	printf '%s' "$j" | jq -r '.payload.data[]? | [.iccid, .profileState, (.profileName // ""), (.profileNickname // ""), (.serviceProviderName // "")] | join("|")'
}

esim_state_of() { printf '%s\n' "$2" | awk -F'|' -v i="$1" '$1 == i { print $2 }'; }
esim_label_of() { printf '%s\n' "$2" | awk -F'|' -v i="$1" '$1 == i { print ($4 != "" ? $4 : $3) }'; }

esim_info() {
	local j
	j=$(lpac_run chip info) || true
	lpac_check "$j" || return 5
	printf '%s' "$j" | jq -r '.payload.data | "EID         : \(.eidValue)\nSM-DP+      : \(.EuiccConfiguredAddresses.defaultDpAddress // "-")\nFree memory : \(.EUICCInfo2.extCardResource.freeNonVolatileMemory // "?") bytes\nInstalled   : \(.EUICCInfo2.extCardResource.installedApplication // "?") applications\nFirmware    : \(.EUICCInfo2.euiccFirmwareVer // "?")  (SGP.22 \(.EUICCInfo2.svn // "?"))"'
	printf 'LPA backend : %s%s\n' "$ESIM_BACKEND" "$([ "$ESIM_BACKEND" = at ] && printf ' (%s)' "$ESIM_TTY")"
}

esim_list() {
	local rows iccid state name nick prov p imei
	rows=$(esim_rows) || return 5
	printf '%-21s %-9s %-14s %-12s %-10s %-7s %s\n' ICCID STATE NAME NICKNAME PROVIDER PROFILE IMEI
	[ -n "$rows" ] || { echo "(no eSIM profiles installed)"; return 0; }
	printf '%s\n' "$rows" | while IFS='|' read -r iccid state name nick prov; do
		[ -n "$iccid" ] || continue
		p=$(profile_by_iccid "$iccid") || p=
		imei=; [ -n "$p" ] && imei=$(profile_get "$p" imei)
		printf '%-21s %-9s %-14s %-12s %-10s %-7s %s\n' "$iccid" "$state" "$name" "$nick" "$prov" "${p:--}" "${imei:--}"
	done
}

modem_restart() { at_once 'AT+CFUN=1,1' 10 | grep -qx OK; }

wait_modem() {  # [expected IMEI] -> 0 once the modem answers AT+GSN (with that IMEI)
	local waited=0 cur
	while :; do
		if at_open 2>/dev/null; then
			cur=$(at_cmd AT+GSN 3 | grep -E '^[0-9]{15}$' | head -n1); at_close
			if [ -n "$cur" ] && { [ -z "${1:-}" ] || [ "$cur" = "$1" ]; }; then return 0; fi
		fi
		[ $waited -ge "$APPLY_TIMEOUT" ] && return 1
		sleep 3; waited=$((waited + 3))
	done
}

esim_enable_raw() {  # iccid
	local j
	j=$(lpac_run profile enable "$1" 1) || true
	lpac_check "$j"
}

esim_enable() {  # iccid [--no-restart]
	local iccid restart=1 a
	iccid=$(iccid_norm "${1:-}")
	for a in "$@"; do [ "$a" = --no-restart ] && restart=0; done
	is_digits "$iccid" || die "usage: simei esim enable <iccid> [--no-restart]" 64
	esim_enable_raw "$iccid" || return 4
	log "esim profile $iccid enabled"
	echo "eSIM profile $iccid enabled"
	[ $restart -eq 1 ] || return 0
	echo "restarting the modem so it re-reads the SIM..."
	modem_restart || echo "warning: AT+CFUN=1,1 was not confirmed" >&2
	wait_modem && echo "modem is back" || echo "warning: modem did not answer within ${APPLY_TIMEOUT}s" >&2
}

esim_disable() {
	local iccid j
	iccid=$(iccid_norm "${1:-}")
	is_digits "$iccid" || die "usage: simei esim disable <iccid>" 64
	j=$(lpac_run profile disable "$iccid" 1) || true
	lpac_check "$j" || return 4
	log "esim profile $iccid disabled"
	echo "eSIM profile $iccid disabled (the modem has no active SIM until another profile is enabled)"
}

esim_delete() {  # iccid [--yes]
	local iccid yes=0 a j
	iccid=$(iccid_norm "${1:-}")
	for a in "$@"; do [ "$a" = --yes ] || [ "$a" = -y ] && yes=1; done
	is_digits "$iccid" || die "usage: simei esim delete <iccid> [--yes]" 64
	if [ $yes -ne 1 ]; then
		[ -t 0 ] || die "add --yes to delete without confirmation" 1
		ui_yesno "Delete eSIM profile" "Delete profile $iccid from the eUICC? This cannot be undone." || die cancelled 1
	fi
	j=$(lpac_run profile delete "$iccid") || true
	lpac_check "$j" || return 4
	log "esim profile $iccid deleted"
	echo "eSIM profile $iccid deleted"
}

esim_nickname() {
	local iccid=$(iccid_norm "${1:-}") j
	is_digits "$iccid" && [ -n "${2:-}" ] || die "usage: simei esim nickname <iccid> <name>" 64
	j=$(lpac_run profile nickname "$iccid" "$2") || true
	lpac_check "$j" || return 4
	echo "nickname of $iccid set to $2"
}

esim_download() {  # activation-code [confirmation-code]
	local code=${1:-} conf=${2:-} j
	[ -n "$code" ] || die "usage: simei esim download 'LPA:1\$smdp\$matching-id' [confirmation-code]" 64
	case $code in LPA:1\$*) ;; *) die "activation code must look like LPA:1\$<smdp>\$<matching id>" 64 ;; esac
	echo "downloading from ${code#LPA:1\$} (this can take a minute)..."
	if [ -n "$conf" ]; then j=$(lpac_run profile download -a "$code" -c "$conf") || true
	else j=$(lpac_run profile download -a "$code") || true; fi
	lpac_check "$j" || return 4
	log "esim profile downloaded ($code)"
	echo "profile downloaded (disabled); enable it with: simei switch <iccid>"
	esim_list
}

cmd_esim() {
	local sub=${1:-list}
	[ $# -gt 0 ] && shift
	case $sub in
		info)                esim_info ;;
		list|ls)             esim_list ;;
		enable)              esim_enable "$@" ;;
		disable)             esim_disable "$@" ;;
		delete|del|rm)       esim_delete "$@" ;;
		nickname|nick|rename) esim_nickname "$@" ;;
		download|dl)         esim_download "$@" ;;
		*) die "usage: simei esim info|list|enable|disable|delete|nickname|download ..." 64 ;;
	esac
}

# switch <iccid|profile> [--yes]: enable that eSIM profile, restart the modem, write its IMEI
cmd_switch() {
	local t=${1:-} yes=0 a iccid p rows state
	for a in "$@"; do case $a in --yes|-y) yes=1 ;; esac; done
	[ -n "$t" ] && [ "$t" != --yes ] && [ "$t" != -y ] || die "usage: simei switch <iccid|profile> [--yes]" 64
	if profile_exists "$t"; then p=$t; iccid=$(profile_get "$t" iccid)
	else iccid=$(iccid_norm "$t"); p=$(profile_by_iccid "$iccid") || p=; fi
	is_digits "$iccid" || die "no ICCID known for $t" 1
	rows=$(esim_rows) || die "cannot read the eUICC" 5
	state=$(esim_state_of "$iccid" "$rows")
	[ -n "$state" ] || die "eSIM profile $iccid is not installed on the eUICC (see: simei esim list)" 3
	if [ "$state" = enabled ]; then
		echo "eSIM profile $iccid ($(esim_label_of "$iccid" "$rows")) is already enabled"
	else
		if [ $yes -ne 1 ]; then
			[ -t 0 ] || die "add --yes to switch without confirmation" 1
			ui_yesno "Switch eSIM profile" "Enable eSIM profile $iccid ($(esim_label_of "$iccid" "$rows"))?
The modem restarts afterwards (about 20 s)." || die cancelled 1
		fi
		esim_enable_raw "$iccid" || die "enable failed" 4
		echo "eSIM profile $iccid enabled; restarting the modem..."
		modem_restart || echo "warning: AT+CFUN=1,1 was not confirmed" >&2
		wait_modem || die "modem did not come back within ${APPLY_TIMEOUT}s" 4
		log "switched eSIM profile to $iccid"
	fi
	if [ -n "$p" ] && [ -n "$(profile_get "$p" imei)" ]; then
		cmd_apply --yes
	else
		echo "note: no IMEI assigned to this SIM yet. Assign one with: simei set <profile> imei <imei>  (or simei add / simei register)"
	fi
}

tui_esim() {
	local rows sel act iccid state name nick prov p v label
	while :; do
		rows=$(esim_rows 2>&1) || { ui_msg "eSIM" "Cannot read the eUICC:
$rows"; return 0; }
		set --
		while IFS='|' read -r iccid state name nick prov; do
			[ -n "$iccid" ] || continue
			p=$(profile_by_iccid "$iccid") || p=
			set -- "$@" "$iccid" "$state | ${nick:-$name} | IMEI $( [ -n "$p" ] && profile_get "$p" imei | sed 's/^$/-/' || echo - )"
		done <<EOR
$rows
EOR
		set -- "$@" download "Download a new profile (activation code)" info "eUICC info (EID, memory)" back "Back"
		sel=$(ui_menu "eSIM profiles" "Select a profile" "$@") || return 0
		case $sel in
			back) return 0 ;;
			info) ui_msg "eUICC" "$(esim_info 2>&1)" ;;
			download)
				v=$(ui_input "Download profile" "Activation code (LPA:1\$smdp\$matching-id)" "LPA:1\$") || continue
				act=$(ui_input "Download profile" "Confirmation code (empty if none)" "") || continue
				ui_msg "Download" "$(esim_download "$v" $act 2>&1)" ;;
			*)
				label=$(esim_label_of "$sel" "$rows")
				act=$(ui_menu "eSIM $sel ($label)" "$(printf '%s\n' "$rows" | awk -F'|' -v i="$sel" '$1 == i { print "state " $2 " | " $3 " | " $4 " | " $5 }')" \
					switch "Enable this profile and write its IMEI" enable "Enable (modem restart)" disable "Disable" \
					imei "Assign / change the IMEI for this SIM" nickname "Set nickname" delete "Delete profile from the eUICC" back "Back") || continue
				case $act in
					back) ;;
					switch) ui_yesno "Switch" "Enable $sel ($label), restart the modem and write its IMEI?" && ui_msg "Switch" "$(cmd_switch "$sel" --yes 2>&1)" ;;
					enable) ui_msg "Enable" "$(esim_enable "$sel" 2>&1)" ;;
					disable) ui_yesno "Disable" "Disable $sel ($label)? The modem has no SIM until another profile is enabled." && ui_msg "Disable" "$(esim_disable "$sel" 2>&1)" ;;
					imei)
						p=$(profile_by_iccid "$sel") || p=
						v=$(ui_input "IMEI for $sel ($label)" "IMEI (14 or 15 digits)" "$( [ -n "$p" ] && profile_get "$p" imei )") || continue
						if [ -n "$p" ]; then ui_msg "IMEI" "$(cmd_set "$p" imei "$v" 2>&1)"
						else ui_msg "IMEI" "$(cmd_add "$label" "$sel" "$v" 2>&1)"; fi ;;
					nickname) v=$(ui_input "Nickname" "New nickname for $sel" "$label") || continue; ui_msg "Nickname" "$(esim_nickname "$sel" "$v" 2>&1)" ;;
					delete) ui_yesno "Delete" "Delete $sel ($label) from the eUICC? This cannot be undone." && ui_msg "Delete" "$(esim_delete "$sel" --yes 2>&1)" ;;
				esac ;;
		esac
	done
}

# ---- TUI ---------------------------------------------------------------------------
tui_profiles() {
	local p items sel action v
	while :; do
		items=
		set --
		for p in $(profile_ids); do
			set -- "$@" "$p" "$(profile_get "$p" name) | $(profile_get "$p" iccid) | IMEI $(profile_get "$p" imei | sed 's/^$/-/')"
		done
		set -- "$@" add "Add a profile for a SIM that is not inserted" back "Back"
		sel=$(ui_menu "SIM profiles" "Select a profile to edit" "$@") || return 0
		case $sel in
			back) return 0 ;;
			add)
				v=$(ui_input "Add profile" "Name" "SIM") || continue
				p=$(ui_input "Add profile" "ICCID (printed on the card, 19-20 digits)" "") || continue
				action=$(ui_input "Add profile" "IMEI to use with this SIM (14 or 15 digits, empty = none)" "") || continue
				ui_msg "Add profile" "$(cmd_add "$v" "$p" "$action" 2>&1)" ;;
			*)
				action=$(ui_menu "Profile $sel" "$(profile_line "$sel")" name "Rename" imei "Set IMEI" apn "Set APN" delete "Delete profile" back "Back") || continue
				case $action in
					back) ;;
					delete) ui_yesno "Delete $sel" "Delete profile $sel ($(profile_get "$sel" name))?" && ui_msg "Delete" "$(cmd_delete "$sel" 2>&1)" ;;
					*) v=$(ui_input "Profile $sel" "New $action" "$(profile_get "$sel" "$action")") || continue
					   ui_msg "Profile $sel" "$(cmd_set "$sel" "$action" "$v" 2>&1)" ;;
				esac ;;
		esac
	done
}

tui_move() {
	local from to p mode
	mode=$(ui_menu "Reassign IMEI" "How to reassign" move "Move IMEI from one SIM profile to another" swap "Swap the IMEIs of two profiles" back "Back") || return 0
	[ "$mode" = back ] && return 0
	set --
	for p in $(profile_ids); do set -- "$@" "$p" "$(profile_get "$p" name) | IMEI $(profile_get "$p" imei | sed 's/^$/-/')"; done
	[ $# -ge 4 ] || { ui_msg "Reassign IMEI" "Need at least two profiles. Register or add SIMs first."; return 0; }
	from=$(ui_menu "Reassign IMEI" "Source profile (gives its IMEI)" "$@") || return 0
	to=$(ui_menu "Reassign IMEI" "Target profile (receives the IMEI)" "$@") || return 0
	ui_yesno "Reassign IMEI" "$mode IMEI: $from ($(profile_get "$from" name)) -> $to ($(profile_get "$to" name))?" || return 0
	ui_msg "Reassign IMEI" "$(cmd_"$mode" "$from" "$to" 2>&1)"
	if modem_read 2>/dev/null; then
		match_profile
		if [ "$P_MATCH" = no ]; then
			ui_yesno "Apply now" "The inserted SIM ($P_ID, $P_NAME) now has IMEI $P_IMEI but the modem reports $M_IMEI. Write it to the modem now?" \
				&& ui_msg "Apply" "$(cmd_apply --yes 2>&1)"
		fi
	fi
}

tui_main() {
	local ch out
	while :; do
		ch=$(ui_menu "simei $VERSION - SIM / IMEI manager" "Modem: $AT_HOST:$AT_PORT" \
			status "Modem and SIM status" \
			live "Live dashboard: bandwidth and signal" \
			profiles "SIM profiles (view, edit, add, delete)" \
			register "Register the inserted SIM as a profile" \
			reassign "Reassign IMEI between SIM profiles" \
			apply "Write the inserted SIM's profile IMEI to the modem" \
			esim "eSIM profiles: list, switch, download, delete" \
			at "Send an AT command" \
			restart "Restart modem / wwan / AT bridge" \
			exit "Exit") || break
		case $ch in
			status) ui_msg "Status" "$(cmd_status 2>&1)" ;;
			live) cmd_live ;;
			profiles) tui_profiles ;;
			register)
				out=$(ui_input "Register SIM" "Name for the inserted SIM" "SIM $(profile_next_id | sed 's/sim//')") || continue
				ui_msg "Register SIM" "$(cmd_register "$out" 2>&1)" ;;
			reassign) tui_move ;;
			esim) tui_esim ;;
			apply)
				out=$(cmd_apply --dry-run 2>&1) || { ui_msg "Apply" "$out"; continue; }
				case $out in "nothing to do"*) ui_msg "Apply" "$out"; continue ;; esac
				ui_yesno "Apply" "$out

The modem restarts afterwards (about 20 s). Continue?" && ui_msg "Apply" "$(cmd_apply --yes 2>&1)" ;;
			at)
				out=$(ui_input "AT command" "Command" "AT+GSN") || continue
				ui_msg "$out" "$(cmd_at "$out" 2>&1)" ;;
			restart)
				out=$(ui_menu "Restart" "What to restart" modem "Modem (AT+CFUN=1,1)" wwan "wwan interface" bridge "AT bridge service" back "Back") || continue
				[ "$out" = back ] || ui_msg "Restart" "$(cmd_restart "$out" 2>&1)" ;;
			exit) break ;;
		esac
	done
	[ "$NO_ANSI" = 1 ] || [ "$UI_MODE" != whiptail ] || clear 2>/dev/null
	return 0
}

usage() {
	cat <<EOF
simei $VERSION - SIM / IMEI manager (Quectel EG25-G, OpenWrt)

  simei                          TUI
  simei status [--raw]           modem + SIM status, matched profile
  simei live [--once]            live bandwidth / signal dashboard
  simei list                     SIM profiles
  simei register [name]          register the inserted SIM with the modem's current IMEI
  simei add <name> <iccid> [imei] [apn]
  simei set <profile> name|imei|apn|iccid <value>
  simei delete <profile>
  simei move <from> <to>         reassign the IMEI to another SIM profile
  simei swap <a> <b>             exchange the IMEIs of two profiles
  simei apply [--yes] [--dry-run] write the inserted SIM's profile IMEI into the modem
  simei switch <iccid|profile> [--yes]  enable that eSIM profile, restart the modem, write its IMEI
  simei esim [list]              eSIM profiles on the eUICC (with the IMEI assigned to each)
  simei esim info                EID, free memory, SM-DP+
  simei esim enable|disable <iccid>
  simei esim delete <iccid> [--yes]
  simei esim nickname <iccid> <name>
  simei esim download <LPA:1$smdp$id> [confirmation-code]
  simei at "<AT command>"        raw AT command via the bridge
  simei luhn <14|15 digits>      compute / verify the IMEI check digit
  simei restart modem|wwan|bridge
EOF
}

case ${1:-tui} in
	status)   shift; cmd_status "$@" ;;
	live)     shift; cmd_live "$@" ;;
	list|ls)  cmd_list ;;
	register) shift; cmd_register "$@" ;;
	add)      shift; cmd_add "$@" ;;
	set)      shift; cmd_set "$@" ;;
	delete|del|rm) shift; cmd_delete "$@" ;;
	move)     shift; cmd_move "$@" ;;
	swap)     shift; cmd_swap "$@" ;;
	apply)    shift; cmd_apply "$@" ;;
	esim)     shift; cmd_esim "$@" ;;
	switch)   shift; cmd_switch "$@" ;;
	at)       shift; cmd_at "$@" ;;
	luhn)     shift; cmd_luhn "$@" ;;
	restart)  shift; cmd_restart "$@" ;;
	tui)      tui_main ;;
	version|--version) echo "simei $VERSION" ;;
	help|-h|--help) usage ;;
	*) usage >&2; exit 64 ;;
esac
